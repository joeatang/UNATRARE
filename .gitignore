# Dependencies
node_modules/

# Next.js build output
.next/
out/

# Environment variables — NEVER commit these
.env.local
.env.*.local
.env

# SQLite database — lives on server, not in git
*.db
*.db-shm
*.db-wal

# Uploads (actual files never in git — directory tracked via .gitkeep)
/public/uploads/*
!/public/uploads/.gitkeep

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
